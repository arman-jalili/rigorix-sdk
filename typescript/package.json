{
  "name": "rigorix-verifier",
  "version": "0.9.0",
  "description": "Protocol-only verification of Rigorix audit envelopes: HMAC, JSON Schema, per-producer chains, and Ed25519 anchor artifacts. Consumes the canonical rigorix-schemas corpus.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser/index.d.ts",
      "import": "./dist/src/browser/index.js",
      "browser": "./dist/src/browser/index.js"
    }
  },
  "files": ["dist/src", "_schemas", "README.md"],
  "license": "Apache-2.0",
  "author": "Arman Wolkenstein-Jalili and Rigorix contributors",
  "keywords": ["rigorix", "audit", "verifier", "hmac", "jsonschema"],
  "repository": {
    "type": "git",
    "url": "https://github.com/arman-jalili/rigorix-sdk.git",
    "directory": "typescript"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "node scripts/bundle-schemas.mjs",
    "guard:browser": "node scripts/check-browser-no-node.mjs",
    "build": "npm run bundle && tsc -p tsconfig.json && npm run guard:browser",
    "prepack": "node scripts/bundle-schemas.mjs",
    "test": "npm run test:node",
    "test:node": "npm run build && node --test dist/test/*.test.js",
    "test:browser": "npm run build && node test/browser/run.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lossless-json": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.6.0"
  }
}
