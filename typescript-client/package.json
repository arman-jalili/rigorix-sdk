{
  "name": "rigorix-client",
  "version": "0.6.0",
  "description": "Protocol-only typed client for the frozen rigorix.* JSON-RPC catalog — governed flows only, no raw step execution, no engine dependency.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md"],
  "license": "Apache-2.0",
  "author": "Arman Wolkenstein-Jalili and Rigorix contributors",
  "keywords": ["rigorix", "jsonrpc", "client", "governance", "sdk"],
  "repository": {
    "type": "git",
    "url": "https://github.com/arman-jalili/rigorix-sdk.git",
    "directory": "typescript-client"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
