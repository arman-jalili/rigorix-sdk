{
  "apiVersion": "1.0.0",
  "jsonrpc": "2.0",
  "transport": {
    "kind": "http-jsonrpc-2.0",
    "endpoint": "/rpc",
    "contentType": "application/json",
    "batch": true,
    "push": {
      "kind": "sse",
      "endpoint": "/events",
      "schema": "api/events.json",
      "events": [
        "approval_required",
        "run_progress",
        "policy_changed"
      ]
    },
    "errorModel": "errors.json"
  },
  "authLevels": {
    "public": "no session required",
    "session": "requires an attested session; identity is taken from the session, never from params",
    "admin": "requires an enterprise scope"
  },
  "methods": [
    {
      "name": "rigorix.plan",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_plan",
      "description": "Resolve a template to a planned DAG with enforcement pre-flight.",
      "params": {
        "$ref": "#/$defs/planParams"
      },
      "result": {
        "$ref": "#/$defs/planResult"
      }
    },
    {
      "name": "rigorix.validatePlan",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_validate_plan",
      "description": "Validate a plan against enforcement + sequence policy without executing.",
      "params": {
        "$ref": "#/$defs/validatePlanParams"
      },
      "result": {
        "$ref": "#/$defs/validateResult"
      }
    },
    {
      "name": "rigorix.run",
      "kind": "command",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_run",
      "description": "Governed execution of a template's plan (pause/approve/deny states).",
      "params": {
        "$ref": "#/$defs/runParams"
      },
      "result": {
        "$ref": "#/$defs/executeResult"
      }
    },
    {
      "name": "rigorix.execute",
      "kind": "command",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_execute",
      "description": "Governed execution of an explicit plan or template.",
      "params": {
        "$ref": "#/$defs/executeParams"
      },
      "result": {
        "$ref": "#/$defs/executeResult"
      }
    },
    {
      "name": "rigorix.approve",
      "kind": "command",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_approve_execution",
      "description": "Human approval bound to the attested session identity (ADR-011).",
      "params": {
        "$ref": "#/$defs/approveParams"
      },
      "result": {
        "$ref": "#/$defs/approveResult"
      }
    },
    {
      "name": "rigorix.checkEnforcement",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_check_enforcement",
      "description": "Enforcement state snapshot (budget, circuit breakers).",
      "params": {
        "$ref": "#/$defs/emptyParams"
      },
      "result": {
        "$ref": "#/$defs/checkEnforcementResult"
      }
    },
    {
      "name": "rigorix.audit.read",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_read_audit",
      "description": "Read one execution's audit record (format text|json).",
      "params": {
        "$ref": "#/$defs/auditReadParams"
      },
      "result": {
        "$ref": "#/$defs/auditReadResult"
      }
    },
    {
      "name": "rigorix.audit.list",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_list_audits",
      "description": "List execution records matching a filter.",
      "params": {
        "$ref": "#/$defs/auditListParams"
      },
      "result": {
        "$ref": "#/$defs/auditListResult"
      }
    },
    {
      "name": "rigorix.audit.summary",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_audit_summary",
      "description": "Aggregate audit summary over a time range.",
      "params": {
        "$ref": "#/$defs/auditSummaryParams"
      },
      "result": {
        "$ref": "#/$defs/auditSummaryResult"
      }
    },
    {
      "name": "rigorix.template.list",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_list_templates",
      "description": "List templates.",
      "params": {
        "$ref": "#/$defs/templateListParams"
      },
      "result": {
        "$ref": "#/$defs/templateListResult"
      }
    },
    {
      "name": "rigorix.template.get",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_get_template",
      "description": "Get one template.",
      "params": {
        "$ref": "#/$defs/templateGetParams"
      },
      "result": {
        "$ref": "#/$defs/templateGetResult"
      }
    },
    {
      "name": "rigorix.template.create",
      "kind": "command",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "session",
      "mcpTool": "rigorix_create_template",
      "description": "Create a template from a plan.",
      "params": {
        "$ref": "#/$defs/templateCreateParams"
      },
      "result": {
        "$ref": "#/$defs/templateCreateResult"
      }
    },
    {
      "name": "rigorix.template.validate",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_validate_template",
      "description": "Validate a plan as a template (no execution).",
      "params": {
        "$ref": "#/$defs/templateValidateParams"
      },
      "result": {
        "$ref": "#/$defs/validateResult"
      }
    },
    {
      "name": "rigorix.auth.login",
      "kind": "command",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_auth_login",
      "description": "Initiate the OIDC device flow (RFC 8628).",
      "params": {
        "$ref": "#/$defs/authLoginParams"
      },
      "result": {
        "$ref": "#/$defs/authLoginResult"
      }
    },
    {
      "name": "rigorix.auth.status",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_auth_status",
      "description": "Report the session token/identity status (redacted).",
      "params": {
        "$ref": "#/$defs/emptyParams"
      },
      "result": {
        "$ref": "#/$defs/authStatusResult"
      }
    },
    {
      "name": "rigorix.auth.logout",
      "kind": "command",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_auth_logout",
      "description": "Log out and clear the session.",
      "params": {
        "$ref": "#/$defs/emptyParams"
      },
      "result": {
        "$ref": "#/$defs/authLogoutResult"
      }
    },
    {
      "name": "rigorix.policy.bundle",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "admin",
      "mcpTool": null,
      "description": "Export the sequence/approval/identity policy bundle (enterprise source of truth).",
      "params": {
        "$ref": "#/$defs/emptyParams"
      },
      "result": {
        "$ref": "#/$defs/policyBundleResult"
      }
    },
    {
      "name": "rigorix.usageGuide",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": "rigorix_get_usage_guide",
      "description": "Self-description for agents.",
      "params": {
        "$ref": "#/$defs/emptyParams"
      },
      "result": {
        "$ref": "#/$defs/usageGuideResult"
      }
    },
    {
      "name": "rigorix.system.version",
      "kind": "query",
      "since": "1.0.0",
      "stability": "frozen",
      "auth": "public",
      "mcpTool": null,
      "description": "Capability/version discovery.",
      "params": {
        "$ref": "#/$defs/emptyParams"
      },
      "result": {
        "$ref": "#/$defs/versionResult"
      }
    }
  ],
  "$defs": {
    "method": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "since",
        "stability",
        "auth",
        "params",
        "result"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^rigorix\\.[a-zA-Z.]+$"
        },
        "kind": {
          "enum": [
            "query",
            "command"
          ]
        },
        "since": {
          "type": "string"
        },
        "stability": {
          "enum": [
            "frozen",
            "draft",
            "deprecated"
          ]
        },
        "auth": {
          "enum": [
            "public",
            "session",
            "admin"
          ]
        },
        "mcpTool": {
          "type": [
            "string",
            "null"
          ],
          "description": "MCP adapter counterpart (ADR-0001 D9)."
        },
        "description": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/schemaRef"
        },
        "result": {
          "$ref": "#/$defs/schemaRef"
        }
      },
      "additionalProperties": false
    },
    "schemaRef": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/\\$defs/"
        }
      },
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "identityRef": {
      "type": "object",
      "description": "Redacted attested identity (projection of ../claims.json $defs.identityRef). Never a raw token.",
      "required": [
        "subject",
        "issuer",
        "source"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "source": {
          "enum": [
            "idp_token",
            "local_principal",
            "unverified"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "claimSummary": {
      "type": "object",
      "description": "Redacted claim summary returned by auth methods. Never contains a raw token or token_ref.",
      "required": [
        "subject",
        "issuer"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "costEstimate": {
      "type": "object",
      "required": [
        "estimated_tokens",
        "estimated_tool_calls"
      ],
      "properties": {
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_micro": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_duration_secs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "blocked_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "stepDefinition": {
      "type": "object",
      "required": [
        "name",
        "tool",
        "parameters",
        "requires_approval",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "requires_approval": {
          "type": "boolean"
        },
        "require_identity": {
          "type": "boolean",
          "default": false,
          "description": "L1 identity gate (additive; defaults false)."
        },
        "description": {
          "type": "string"
        },
        "timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evaluate_score": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "planTemplate": {
      "type": "object",
      "required": [
        "name",
        "description",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stepDefinition"
          }
        },
        "constraints": {
          "oneOf": [
            {
              "$ref": "#/$defs/constraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "stepResult": {
      "type": "object",
      "required": [
        "step_name",
        "success",
        "duration_ms"
      ],
      "properties": {
        "step_name": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {},
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "planParams": {
      "type": "object",
      "required": [
        "template_name"
      ],
      "properties": {
        "template_name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "planResult": {
      "type": "object",
      "required": [
        "template_name",
        "description",
        "version",
        "tags",
        "graph",
        "enforcement"
      ],
      "properties": {
        "template_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graph": {
          "type": "object",
          "required": [
            "sealed",
            "node_count",
            "nodes"
          ],
          "properties": {
            "sealed": {
              "type": "boolean"
            },
            "node_count": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "tool",
                  "description",
                  "dependencies"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tool": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "constraints": {
          "oneOf": [
            {
              "$ref": "#/$defs/constraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "enforcement": {
          "type": "object",
          "required": [
            "valid",
            "warnings",
            "errors"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "estimated_cost": {
              "oneOf": [
                {
                  "$ref": "#/$defs/costEstimate"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validatePlanParams": {
      "type": "object",
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/planTemplate"
        },
        "identity": {
          "$ref": "#/$defs/identityRef",
          "description": "Server-injected attested identity; ignored if supplied by the caller (D5)."
        }
      },
      "additionalProperties": false
    },
    "validateResult": {
      "type": "object",
      "required": [
        "valid",
        "warnings",
        "errors"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_cost": {
          "oneOf": [
            {
              "$ref": "#/$defs/costEstimate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "runParams": {
      "type": "object",
      "required": [
        "template_name"
      ],
      "properties": {
        "template_name": {
          "type": "string"
        },
        "execution_id": {
          "$ref": "#/$defs/uuid",
          "description": "Optional idempotency key (D7)."
        },
        "repository": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "description": "Display-only (D5)."
        }
      },
      "additionalProperties": false
    },
    "executeParams": {
      "type": "object",
      "description": "Exactly one of plan / template_name must be provided.",
      "properties": {
        "plan": {
          "$ref": "#/$defs/planTemplate"
        },
        "template_name": {
          "type": "string"
        },
        "execution_id": {
          "$ref": "#/$defs/uuid"
        },
        "repository": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "description": "Display-only (D5)."
        }
      },
      "additionalProperties": false
    },
    "executeResult": {
      "type": "object",
      "required": [
        "execution_id",
        "status",
        "steps",
        "duration_ms",
        "audit_uri"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepResult"
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_used": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "audit_uri": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approveParams": {
      "type": "object",
      "required": [
        "execution_id",
        "step_names"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/uuid"
        },
        "step_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approver_id": {
          "type": "string",
          "description": "Display-only; authorization uses the attested session (D5)."
        },
        "authority": {
          "type": "string",
          "description": "Display-only (D5)."
        },
        "token_claims_ref": {
          "type": "string",
          "description": "Display-only; server derives this from the session (D5)."
        }
      },
      "additionalProperties": false
    },
    "approveResult": {
      "type": "object",
      "required": [
        "execution_id",
        "approved_steps",
        "not_found",
        "still_pending",
        "resumed",
        "message"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/uuid"
        },
        "approved_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "still_pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumed": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "final_state": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "is_complete",
                "completed_count",
                "failed_count",
                "total_nodes"
              ],
              "properties": {
                "is_complete": {
                  "type": "boolean"
                },
                "completed_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_nodes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "checkEnforcementResult": {
      "type": "object",
      "required": [
        "active",
        "preset",
        "budget",
        "circuit_breakers"
      ],
      "properties": {
